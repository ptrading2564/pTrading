# ==============================================================================
# pTrading Configuration Environment Variables
# ==============================================================================

# Application Environment & Server Settings
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///data/ptrading.db

# Domain & Webhook Security
DOMAIN_NAME=trading2564.com
WEBHOOK_SECRET=your_super_secret_webhook_token_here_change_me
# Set to false in local development/testing to accept webhooks from any IP
VERIFY_TRADINGVIEW_IP=true

# Dashboard Authentication
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change_this_to_a_secure_password
SESSION_SECRET_KEY=change_this_to_a_random_32_byte_secret_key

# Alpaca API Credentials (Paper account by default)
ALPACA_API_KEY=PK...
ALPACA_SECRET_KEY=sk...
ALPACA_PAPER=true
# Set to https://api.alpaca.markets for live trading
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Trading Execution Mode: AUTO | SEMI_AUTO | PAUSED
EXECUTION_MODE=SEMI_AUTO

# Risk Management Parameters
RISK_PERCENT_PER_TRADE=0.5
MAX_CONCURRENT_POSITIONS=4
MAX_EQUITY_PERCENT_PER_STOCK=25.0
DAILY_MAX_LOSS_PERCENT=2.0
MIN_STOP_DISTANCE_DOLLARS=0.10
BREAKEVEN_TRIGGER_R=1.0
BREAKEVEN_OFFSET_DOLLARS=0.02
STALE_ORDER_TIMEOUT_SECONDS=180

# Market Timings (Eastern Time)
MARKET_TIMEZONE=America/New_York
EOD_FLATTEN_TIME=15:55
EARLY_CLOSE_FLATTEN_TIME=12:55

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
TELEGRAM_CHAT_ID=123456789
TELEGRAM_ENABLED=true
